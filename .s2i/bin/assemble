#!/bin/bash

set -e

echo "Custom assemble script: Importing custom CA certificates..."

if [ -d "/opt/app-root/src/etc-pki-tls" ]; then
    echo "Found CA certificates in /opt/app-root/src/etc-pki-tls"
    
    if [ -f "/opt/app-root/src/etc-pki-tls/repo-ca.crt" ]; then
        echo "Importing repo-ca.crt into custom Java truststore..."
        
        SYSTEM_CACERTS="/etc/pki/java/cacerts"
        CUSTOM_CACERTS="$HOME/cacerts"
        CERT_ALIAS="repo-ca"
        
        if [ -f "$SYSTEM_CACERTS" ]; then
            cp "$SYSTEM_CACERTS" "$CUSTOM_CACERTS"
            chmod 644 "$CUSTOM_CACERTS"
            
            keytool -import -noprompt -trustcacerts \
                -alias "$CERT_ALIAS" \
                -file "/opt/app-root/src/etc-pki-tls/repo-ca.crt" \
                -keystore "$CUSTOM_CACERTS" \
                -storepass changeit
            
            echo "Certificate imported successfully"
            
            export MAVEN_OPTS="${MAVEN_OPTS} -Djavax.net.ssl.trustStore=$CUSTOM_CACERTS -Djavax.net.ssl.trustStorePassword=changeit"
            echo "MAVEN_OPTS updated to use custom truststore: $MAVEN_OPTS"
        else
            echo "Warning: System cacerts not found at $SYSTEM_CACERTS"
        fi
    else
        echo "No repo-ca.crt found"
    fi
else
    echo "No custom CA certificates directory found, skipping certificate import"
fi

echo "Calling default S2I assemble script..."
exec /usr/libexec/s2i/assemble
